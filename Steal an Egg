-- ===== Server Hop =====
local visitedServers = {}

local function getServerList()
    local servers = {}
    local cursor = nil
    repeat
        local url = "https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Asc&limit=50"
        if cursor then url = url .. "&cursor=" .. cursor end
        local s, r = pcall(HttpService.GetAsync, HttpService, url)
        if s then
            local d = HttpService:JSONDecode(r)
            if d and d.data then
                for _, sv in ipairs(d.data) do
                    if sv.playing < sv.maxPlayers and sv.id ~= game.JobId then
                        table.insert(servers, sv)
                    end
                end
            end
            cursor = d.nextPageCursor
        else
            break
        end
    until not cursor
    return servers
end

local function filterVisited(servers)
    local f = {}
    local t = os.time()
    for _, sv in ipairs(servers) do
        local lv = visitedServers[sv.id]
        if not lv or (t - lv) >= COOLDOWN_TIME then table.insert(f, sv) end
    end
    return f
end

local function markVisited(id)
    if id and id ~= "" then visitedServers[id] = os.time() end
end

