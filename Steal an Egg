                    TextSize = 12, TextColor3 = C.Text, BackgroundTransparency = 1,
                    Size = UDim2.new(0.7, 0, 0, 16),
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
                }, c)

                local vLbl = mk("TextLabel", {
                    Text = tostring(val), Font = Enum.Font.GothamBold,
                    TextSize = 12, TextColor3 = C.Accent, BackgroundTransparency = 1,
                    Size = UDim2.new(0.3, 0, 0, 16), Position = UDim2.new(0.7, 0, 0, 0),
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
                }, c)

                local track = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 5),
                    Position = UDim2.new(0, 0, 0, 30),
                    BackgroundColor3 = C.Bg, BorderSizePixel = 0, ZIndex = 5,
                }, c)
                crn(track, 3)

                local fill = mk("Frame", {
                    Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 6,
                }, track)
                crn(fill, 3)

                local kn = mk("Frame", {
                    Size = UDim2.fromOffset(12, 12),
                    Position = UDim2.new((val - min) / (max - min), -6, 0.5, -6),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0, ZIndex = 7,
                }, track)
                crn(kn, 6)

                local hit = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 21),
                    BackgroundTransparency = 1, Text = "", ZIndex = 8,
                }, c)

                local drag = false
                local function upd(x)
                    local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local raw = min + a * (max - min)
                    local st = math.floor(raw / step + 0.5) * step
                    val = math.clamp(st, min, max)
                    local al = (val - min) / (max - min)
                    fill.Size = UDim2.new(al, 0, 1, 0)
                    kn.Position = UDim2.new(al, -6, 0.5, -6)
                    vLbl.Text = tostring(val)
                end

                hit.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                        drag = true
                        upd(inp.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(inp)
                    if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement
                        or inp.UserInputType == Enum.UserInputType.Touch) then
                        upd(inp.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(inp)
                    if (inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch) and drag then
                        drag = false
                        if o.Callback then o.Callback(val) end
                    end
                end)

                local api = {}
                api.Set = function(v)
                    val = math.clamp(v, min, max)
                    local al = (val - min) / (max - min)
                    fill.Size = UDim2.new(al, 0, 1, 0)
                    kn.Position = UDim2.new(al, -6, 0.5, -6)
                    vLbl.Text = tostring(val)
                end
                api.Get = function() return val end
                return api
            end

            function sec:Dropdown(o)
                local values = o.Values or {}
                local multi = o.Multi or false
                local sel = o.Value or (multi and {} or nil)

                local c = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = C.Element, BorderSizePixel = 0, ZIndex = 4,
                }, sf)
                crn(c, 8)

                local lbl = mk("TextLabel", {
                    Text = o.Title or "Dropdown", Font = Enum.Font.GothamMedium,
                    TextSize = 13, TextColor3 = C.Text, BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -60, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
                }, c)

                local arw = mk("TextLabel", {
                    Text = "▼", Font = Enum.Font.GothamBold, TextSize = 11,
                    TextColor3 = C.Sub, BackgroundTransparency = 1,
                    Size = UDim2.fromOffset(20, 20),
                    Position = UDim2.new(1, -30, 0.5, -10), ZIndex = 5,
                }, c)

                local list = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, math.min(#values * 26 + 8, 160)),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = C.Panel, BorderSizePixel = 0,
                    Visible = false, ZIndex = 20,
                }, c)
                crn(list, 8)
                strk(list, C.Border, 1)
                pad(list, 4)

                local scroll = mk("ScrollingFrame", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = C.Accent,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 21,
                }, list)
                mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

                local itemRefs = {}

                local function refreshLbl()
                    if multi then
                        local n = 0
                        for _ in pairs(sel) do n = n + 1 end
                        if n == 0 then
                            lbl.Text = o.Title or "Dropdown"
                            lbl.TextColor3 = C.Text
                        else
                            lbl.Text = (o.Title or "Dropdown") .. " (" .. n .. ")"
                            lbl.TextColor3 = C.Accent
                        end
                    else
                        if sel then
                            lbl.Text = sel
                            lbl.TextColor3 = C.Accent
                        else
                            lbl.Text = o.Title or "Dropdown"
                            lbl.TextColor3 = C.Text
                        end
                    end
                end

                for _, v in ipairs(values) do
                    local it = mk("TextButton", {
                        Text = "", BackgroundColor3 = C.Element,
                        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 24),
                        AutoButtonColor = false, ZIndex = 22,
                    }, scroll)
                    crn(it, 5)

                    local iLbl = mk("TextLabel", {
                        Text = tostring(v), Font = Enum.Font.Gotham,
                        TextSize = 12, TextColor3 = C.Text,
                        BackgroundTransparency = 1,
                        Position = UDim2.new(0, 10, 0, 0),
                        Size = UDim2.new(1, -20, 1, 0),
                        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23,
                    }, it)

                    itemRefs[tostring(v)] = iLbl

                    it.MouseEnter:Connect(function()
                        TweenService:Create(it, TweenInfo.new(0.1), { BackgroundColor3 = C.Hover }):Play()
                    end)
                    it.MouseLeave:Connect(function()
                        TweenService:Create(it, TweenInfo.new(0.1), { BackgroundColor3 = C.Element }):Play()
                    end)

                    it.MouseButton1Click:Connect(function()
                        if multi then
                            if sel[v] then
                                sel[v] = nil
                                iLbl.TextColor3 = C.Text
                            else
                                sel[v] = true
                                iLbl.TextColor3 = C.Accent
                            end
                        else
                            for _, oL in pairs(itemRefs) do oL.TextColor3 = C.Text end
                            sel = v
                            iLbl.TextColor3 = C.Accent
                            list.Visible = false
                        end
                        refreshLbl()
                        if o.Callback then
                            if multi then
                                local a = {}
                                for k in pairs(sel) do table.insert(a, k) end
                                o.Callback(a)
                            else
                                o.Callback(sel)
                            end
                        end
                    end)
                end

                if multi and type(sel) == "table" then
                    for k in pairs(sel) do
                        if itemRefs[k] then itemRefs[k].TextColor3 = C.Accent end
                    end
                elseif not multi and sel and itemRefs[sel] then
                    itemRefs[sel].TextColor3 = C.Accent
                end

                refreshLbl()

                local btn = mk("TextButton", {
                    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                    Text = "", ZIndex = 6,
                }, c)
                btn.MouseButton1Click:Connect(function()
                    list.Visible = not list.Visible
                    arw.Text = list.Visible and "▲" or "▼"
                end)
                btn.MouseEnter:Connect(function()
                    TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Hover }):Play()
                end)
                btn.MouseLeave:Connect(function()
                    TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Element }):Play()
                end)

                local api = {}
                api.Set = function(v) sel = v refreshLbl() end
                api.Get = function() return sel end
                return api
            end

            table.insert(tab.Sections, sec)
            return sec
        end

        return tab
    end

    local notifBox = mk("Frame", {
        Size = UDim2.new(0, 280, 1, -20),
        Position = UDim2.new(1, -290, 0, 10),
        BackgroundTransparency = 1, ZIndex = 100,
    }, gui)
    mk("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, notifBox)

    function win:Notify(o)
        local n = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = C.Panel, BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 101,
        }, notifBox)
        crn(n, 8)
        strk(n, C.Accent, 1)
        pad(n, 8, 12, 8, 12)

        mk("Frame", {
            Size = UDim2.new(0, 3, 1, -8),
            Position = UDim2.new(0, -6, 0, 4),
            BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 102,
        }, n)

        local t = mk("TextLabel", {
            Text = o.Title or "Notification", Font = Enum.Font.GothamBold,
            TextSize = 12, TextColor3 = C.Text, BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 16),
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102,
        }, n)

        local ctext = mk("TextLabel", {
            Text = o.Content or "", Font = Enum.Font.Gotham, TextSize = 11,
            TextColor3 = C.Sub, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 18),
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, ZIndex = 102,
        }, n)

        task.delay(o.Duration or 5, function()
            TweenService:Create(n, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(t, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
            TweenService:Create(ctext, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
            task.wait(0.3)
            n:Destroy()
        end)
    end

    return win
end

