        PersistBtn.Text = "Auto-Exec  On"
        TweenService:Create(PersistBtn, TweenInfo.new(0.2), {BackgroundColor3 = COL.SuccessBg}):Play()
        TweenService:Create(PersistStroke, TweenInfo.new(0.2), {Color = COL.Success, Transparency = 0.2}):Play()
    else
