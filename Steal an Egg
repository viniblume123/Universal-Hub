    pad(n, 12, 16, 12, 18)

    local ac = mk("Frame", {
        Size = UDim2.new(0, 3, 1, -18),
        Position = UDim2.new(0, -11, 0, 9),
        BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 102,
    }, n)
    crn(ac, 2)

    local t = mk("TextLabel", {
        Text = o.Title or "Notification", Font = Enum.Font.GothamBold,
        TextSize = 12, TextColor3 = C.Text, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102,
    }, n)

    local ct = mk("TextLabel", {
        Text = o.Content or "", Font = Enum.Font.Gotham, TextSize = 11,
        TextColor3 = C.Sub, BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 18),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, ZIndex = 102,
    }, n)

    task.delay(o.Duration or 4, function()
        TweenService:Create(n, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(t, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        TweenService:Create(ct, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        TweenService:Create(ac, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        task.wait(0.3)
        n:Destroy()
    end)
end

