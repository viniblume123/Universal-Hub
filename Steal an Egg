local function resolveEntry(cat)
    if not Assets then return nil end
    local dirs = { Assets.Directory, Assets.Assets, Assets.Eggs, Assets.Pets }
    for _, dir in ipairs(dirs) do
        if type(dir) == "table" then
            local e = dir[cat]
            if e then return e end
        end
    end
    return nil
end

local function getNameFromEntry(e, cat)
    if not e then return tostring(cat) end
    if type(e) == "string" then return e end
    if type(e) == "table" then
        return e.DisplayName or e.Name or e.Title or e.EggName or tostring(cat)
    end
    return tostring(cat)
end

local function getRateFromEntry(e)
    if not e or type(e) ~= "table" then return 0 end
    local r = e.EarningRate or e.Rate or e.Income or e.BaseEarning or e.MoneyPerSecond
    if type(r) == "number" and r > 0 then return r end
    if e.Base then
        local br = e.Base.EarningRate or e.Base.Rate or e.Base.Income
        if type(br) == "number" then return br end
    end
    return 0
end

local function getRarityFromEntry(e)
    if not e or type(e) ~= "table" then return "?" end
    if e.Rarity then
        if type(e.Rarity) == "table" then
            return e.Rarity.DisplayName or e.Rarity.Name or "?"
        end
        return tostring(e.Rarity)
    end
    return "?"
end

local function getEggName(egg)
    if type(egg) ~= "table" then return "?" end
    local cat = egg.AssetCategory or egg.Category or egg.Asset or egg.EggId or egg.Id
    local e = resolveEntry(cat)
    return getNameFromEntry(e, cat)
end

local function getEggRate(egg)
    if type(egg) ~= "table" then return 0 end
    local cat = egg.AssetCategory or egg.Category or egg.Asset or egg.EggId or egg.Id
    local e = resolveEntry(cat)
    local r = getRateFromEntry(e)
    if r > 0 then return r end
    return egg.EarningRate or egg.Rate or egg.Income or 0
end

local function getEggValue(egg)
    if type(egg) ~= "table" then return 0 end
    if type(egg.Value) == "number" and egg.Value > 0 then return egg.Value end
    local rate = getEggRate(egg)
    if type(rate) ~= "number" or rate <= 0 then return 0 end
    local scale = egg.Scale or egg.Size or 1
    if type(scale) ~= "number" then scale = 1 end
    local v = rate * (scale ^ 1.85)
    local muts = egg.Mutations or {}
    if type(muts) == "table" then
        for _, m in ipairs(muts) do
            if type(m) == "table" then
                v = v * (m.Multiplier or m.EarningMulti or 1)
            end
        end
    end
    return v
end

local function normalizeName(s)
    if type(s) ~= "string" then return "" end
    return s:lower():gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
end

local function nameMatches(a, b)
    local na = normalizeName(a)
    local nb = normalizeName(b)
    if na == "" or nb == "" then return false end
    if na == nb then return true end
    local sa = na:gsub(" egg$", ""):gsub(" pet$", "")
    local sb = nb:gsub(" egg$", ""):gsub(" pet$", "")
    if sa == sb then return true end
    if sa:find(sb, 1, true) then return true end
    if sb:find(sa, 1, true) then return true end
    return false
end

local cachedEggs = {}
local lastCacheTime = 0
local snapshotRemote = nil
local hookMethodWorked = false
local lastDumpInfo = "not yet"

local function findSnapshotRemote()
    local pk = RS:FindFirstChild("Packages")
    if not pk then return nil end
    local net = pk:FindFirstChild("Networking")
    if not net then return nil end
    for _, d in ipairs(net:GetDescendants()) do
        if d:IsA("RemoteFunction") then
            local n = d.Name:lower()
            if n:find("askfieldeggsnapshot") or (n:find("snapshot") and n:find("egg")) then
                return d
            end
        end
    end
    for _, d in ipairs(net:GetDescendants()) do
        if d:IsA("RemoteFunction") and d.Name:lower():find("field") then
            return d
        end
    end
    return nil
end

local function fetchSnapshot()
    if not snapshotRemote then
        snapshotRemote = findSnapshotRemote()
    end
    if not snapshotRemote then return false end
    local ok, res = pcall(function() return snapshotRemote:InvokeServer() end)
    if not ok then
        snapshotRemote = nil
        return false
    end
    if type(res) ~= "table" then return false end
    local list = {}
    for _, v in pairs(res) do
        if type(v) == "table" then table.insert(list, v) end
    end
    if #list == 0 then return false end
    cachedEggs = list
    lastCacheTime = tick()
    return true
end

local function installNamecallHook()
    if not hookmetamethod then return false end
    local ok, err = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }
            local result = old(self, ...)
            if method == "InvokeServer" and self and self.Name then
                local n = self.Name:lower()
                if n:find("snapshot") or n:find("askfieldegg") then
                    if type(result) == "table" then
                        local list = {}
                        for _, v in pairs(result) do
                            if type(v) == "table" then table.insert(list, v) end
                        end
                        if #list > 0 then
                            cachedEggs = list
                            lastCacheTime = tick()
                            hookMethodWorked = true
                        end
                    end
                end
            end
            return result
        end)
        setreadonly(mt, true)
    end)
    return ok
end

installNamecallHook()

local function parseMoney(s)
    if type(s) == "number" then return s end
    if type(s) ~= "string" then return 0 end
    local clean = s:gsub("[%s,]", ""):upper()
    local suf = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Q = 1e15 }
    local n = tonumber(clean)
    if n then return n end
    local sfx = clean:match("([KMBTQ])$")
    if sfx then
        local base = tonumber(clean:sub(1, -2))
        if base then return base * suf[sfx] end
    end
    return 0
end

local function formatMoney(n)
    if type(n) ~= "number" then return "0" end
    if n >= 1e15 then return string.format("%.2fQ", n / 1e15) end
    if n >= 1e12 then return string.format("%.2fT", n / 1e12) end
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return tostring(math.floor(n))
end

local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(PlaceId)
    local ok, b = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    return ok and b and b.data or {}
end

local function findServer()
    local servers = getServers()
    local pool = {}
    for _, s in ipairs(servers) do
        if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
            local n = s.playing or 0
            if n <= CONFIG.MaxPlayers then table.insert(pool, s) end
        end
    end
    if #pool == 0 then
        for _, s in ipairs(servers) do
            if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then return s.id end
        end
        return nil
    end
    table.sort(pool, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
    return pool[1].id
end

local function setSize(set)
    if type(set) ~= "table" then return 0 end
    local n = 0
    for _ in pairs(set) do n = n + 1 end
    return n
end

local function checkEggs()
    local minMoney = parseMoney(CONFIG.MinMoneyText)
    local hasEggFilter = setSize(CONFIG.SelectedEggs) > 0

    if #cachedEggs == 0 then return false, 0, nil, false, 0, "no-cache" end

    local bestV, bestE = 0, nil
    local anySpawned = false
    local matchCount = 0

    for _, egg in ipairs(cachedEggs) do
        local en = getEggName(egg)
        local matched = not hasEggFilter
        if hasEggFilter then
            for target in pairs(CONFIG.SelectedEggs) do
                if nameMatches(en, target) then matched = true break end
            end
        end
        if matched then
            anySpawned = true
            matchCount = matchCount + 1
            local v = getEggValue(egg)
            if v > bestV then bestV = v bestE = en end
        end
    end

    return bestV >= minMoney, bestV, bestE, anySpawned, matchCount, "ok"
end

local function doHop()
    local t = findServer()
    if t then TeleportService:TeleportToPlaceInstance(PlaceId, t, LocalPlayer)
    else TeleportService:Teleport(PlaceId, LocalPlayer) end
end

