RunService.Heartbeat:Connect(function()
    if not CONFIG.AutoHopServer then
        lastState = nil
        return
    end

    local enough, bestV, eggName, anySpawned = checkEggs()

    if enough then
        if lastState ~= "stay" then
            lastState = "stay"
            setStatus("active")
            notify({
                Title = "Target Found",
                Content = (eggName or "?") .. "\n" .. formatMoney(bestV) .. " $/s",
                Duration = 5,
            })
        end
    elseif anySpawned then
        if lastState ~= "hop" then
            lastState = "hop"
            setStatus("waiting")
            notify({
                Title = "Hopping",
                Content = (eggName or "?") .. " · " .. formatMoney(bestV) .. " $/s",
                Duration = 4,
            })
            doHop()
        end
    else
        if lastState ~= "wait" then
            lastState = "wait"
            setStatus("waiting")
        end
    end
end)

