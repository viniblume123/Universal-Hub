local function waitTeleportCooldown()
    local last = readLastTeleport()
    local elapsed = os.time() - last
    if elapsed < TELEPORT_COOLDOWN then
        local remaining = TELEPORT_COOLDOWN - elapsed
        for i = remaining, 1, -1 do
            hopBtn.Text = "Aguardando " .. i .. "s..."
            task.wait(1)
        end
    end
end

