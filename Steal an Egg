local function applyAutoExecVisual(on)
    if on then
        persistBtn.Text = "Auto-Exec  ON"
        TweenService:Create(persistBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 78, 50)}):Play()
        TweenService:Create(persistStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 220, 140), Transparency = 0.3}):Play()
    else
        persistBtn.Text = "Auto-Exec  OFF"
        TweenService:Create(persistBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 42)}):Play()
        TweenService:Create(persistStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(70, 70, 95), Transparency = 0.4}):Play()
    end
end

local function armLoader()
    if not queueFunc then return false end
    return pcall(function() queueFunc(buildLoader()) end)
end

local function enableAutoExec()
    if SCRIPT_URL == "" or not queueFunc then return false end
    writeAutoExec(true)
    if not armLoader() then
        writeAutoExec(false)
        return false
    end
    persistOn = true
    return true
end

local function disableAutoExec()
    persistOn = false
    writeAutoExec(false)
    armLoader()
end

