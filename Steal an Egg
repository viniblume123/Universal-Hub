local function ApplyVersion(V)
    WriteVersion(V)
    if V == "lennon" then
        TryLoad(LENNON_URL, "Lennon Hub")
    elseif V == "on" then
        TryLoad(ONHUB_URL, "ON Hub")
    elseif V == "both" then
        TryLoad(LENNON_URL, "Lennon Hub")
        task.wait(0.6)
        TryLoad(ONHUB_URL, "ON Hub")
    elseif V == "both_auto" then
        TryLoad(LENNON_URL, "Lennon Hub")
        task.wait(0.6)
        TryLoad(ONHUB_URL, "ON Hub")
        if not LennonAutoStarted then
            LennonAutoStarted = true
            StartLennonAutoClick()
            Notify("Lennon Hub", "Auto-Click Started", 4)
        end
    end
end

