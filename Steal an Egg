local lastState = nil
RunService.Heartbeat:Connect(function()
    if not CONFIG.AutoHopServer then return end

    local enough, bestV, eggName, anySpawned = checkEggs()

    if enough then
        -- Spawned AND value >= min: stay
        if lastState ~= "stay" then
            lastState = "stay"
            setStatus("active")
            notify({
                Title = "Target Found",
                Content = (eggName or "?") .. "\n" .. formatMoney(bestV) .. " $/s",
                Duration = 5,
            })
        end
    elseif anySpawned then
        -- Spawned but value < min: hop
        if lastState ~= "hop" then
            lastState = "hop"
            setStatus("waiting")
            notify({
                Title = "Hopping",
                Content = (eggName or "?") .. " spawned but only " .. formatMoney(bestV) .. " $/s",
                Duration = 4,
            })
            doHop()
        end
    else
        -- No matching egg spawned: wait, don't hop
        if lastState ~= "wait" then
            lastState = "wait"
            setStatus("waiting")
        end
    end
end)

