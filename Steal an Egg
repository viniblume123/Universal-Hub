        TweenService:Create(PersistBtn, TweenInfo.new(0.2), {BackgroundColor3 = COL.Card}):Play()
        TweenService:Create(PersistStroke, TweenInfo.new(0.2), {Color = COL.Stroke, Transparency = 0.3}):Play()
    end
end

local function ArmLoader()
    if not queueFunc then return false end
    return pcall(function() queueFunc(BuildLoader()) end)
end

local function EnableAutoExec()
    if not queueFunc then return false end
    if game.PlaceId ~= ALLOWED_PLACE_ID then
        Notify("Auto-Exec", "Only Works in This Game", 4)
        return false
    end
    WriteAutoExec(true)
    if not ArmLoader() then
        WriteAutoExec(false)
        return false
    end
    PersistOn = true
    return true
end

local function DisableAutoExec()
    PersistOn = false
    WriteAutoExec(false)
    ArmLoader()
end

PersistBtn.MouseButton1Click:Connect(function()
