local function WaitTeleportCooldown()
    local Elapsed = os.time() - ReadLastTeleport()
    if Elapsed < TELEPORT_COOLDOWN then
        for I = (TELEPORT_COOLDOWN - Elapsed), 1, -1 do
            HopBtn.Text = "Waiting " .. I .. "s..."
            task.wait(1)
        end
    end
end

local HopBusy = false

HopBtn.MouseButton1Click:Connect(function()
    if HopBusy then return end
    HopBusy = true
    task.spawn(function()
        HopBtn.Text = "Searching..."
        while HopBusy do
            WaitTeleportCooldown()
            local OkFind, Server = pcall(FindBestServer)
            if not OkFind then Server = nil end
            if not Server then
                task.wait(0.5)
                local Ok2, S2 = pcall(FindBestServer)
                if Ok2 then Server = S2 end
            end
            if Server then
                MarkVisited(Server.id)
                HopBtn.Text = "Joining..."
                local Ok = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PLACE_ID, Server.id, LocalPlayer)
                end)
                if not Ok then
                    HopBtn.Text = "Failed, Retry..."
                    task.wait(HOP_RETRY_DELAY)
                else
                    WriteLastTeleport(os.time())
                    local S = ReadStats()
                    S.hops = S.hops + 1
                    WriteStats(S)
                    pcall(RefreshStats)
                    task.wait(HOP_RETRY_DELAY)
                end
            else
                HopBtn.Text = "No Server, Retry..."
                task.wait(HOP_RETRY_DELAY)
            end
        end
        HopBtn.Text = "Server Hop"
    end)
end)

