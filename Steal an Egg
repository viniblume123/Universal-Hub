local function parseMoney(s)
    if type(s) == "number" then return s end
    if type(s) ~= "string" then return 0 end
    local clean = s:gsub("%s", ""):upper()
    local suf = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Q = 1e15 }
    local n = tonumber(clean)
    if n then return n end
    local sfx = clean:match("([KMBTQ])$")
    if sfx then
        local base = tonumber(clean:sub(1, -2))
        if base then return base * suf[sfx] end
    end
    return 0
end

local function saveCfg(name)
    if not writefile or not name or name == "" then return false end
    local ok = pcall(function()
        if makefolder then makefolder(CFolder) end
        writefile(CFolder .. "/" .. name .. ".json", HttpService:JSONEncode(CONFIG))
    end)
    return ok
end

local function loadCfg(name)
    if not readfile or not name or name == "" then return false end
    local ok, data = pcall(readfile, CFolder .. "/" .. name .. ".json")
    if not ok or not data then return false end
    local ok2, dec = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok2 or type(dec) ~= "table" then return false end
    for k, v in pairs(dec) do CONFIG[k] = v end
    return true
end

local function listCfgs()
    if not listfiles then return {} end
    local ok, files = pcall(listfiles, CFolder)
    if not ok or not files then return {} end
    local names = {}
    for _, f in ipairs(files) do
        local n = f:match("([^/\\]+)%.json$")
        if n then table.insert(names, n) end
    end
    return names
end

local function delCfg(name)
    if not delfile or not name or name == "" then return false end
    local ok = pcall(delfile, CFolder .. "/" .. name .. ".json")
