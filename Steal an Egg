local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(PlaceId)
    local ok, b = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    return ok and b and b.data or {}
end

local function findServer()
    local servers = getServers()
    local pool = {}
    for _, s in ipairs(servers) do
        if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
            local n = s.playing or 0
            if n >= CONFIG.MinPlayers and n <= CONFIG.MaxPlayers then
                table.insert(pool, s)
            end
        end
    end
    if #pool == 0 then
        for _, s in ipairs(servers) do
            if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
                return s.id
            end
        end
        return nil
    end
    table.sort(pool, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
    return pool[1].id
end

local function sendWebhook(title, desc, color)
    if not CONFIG.WebhookEnabled or CONFIG.WebhookUrl == "" then return end
    local id = CONFIG.WebhookUrl:match("/webhooks/(%d+)/")
    local tk = CONFIG.WebhookUrl:match("/webhooks/%d+/(.+)")
    if not id or not tk then return end
    local url = "https://webhook.lewisakura.moe/api/webhooks/" .. id .. "/" .. tk
    local body = {
        username = "Steal a Egg",
        embeds = {{
            title = title,
            description = desc,
            color = color or 0xFF2B47,
            footer = { text = os.date("%Y-%m-%d %H:%M:%S") },
        }},
    }
    pcall(function()
        HttpService:PostAsync(url, HttpService:JSONEncode(body), Enum.HttpContentType.ApplicationJson)
    end)
end

local function checkEggs()
    local snap = getSnap()
    if #snap == 0 then return false, 0, nil end
    local bestV, bestE = 0, nil
    for _, egg in ipairs(snap) do
        local en = egg.Name or egg.EggName or ""
        local rar = egg.Rarity or egg.Category or ""
        local area = egg.Area or ""
        local muts = egg.Mutations or {}
        local rate = egg.EarningRate or egg.Rate or 0
        local scale = egg.Scale or 1
        local v = rate * (scale ^ 1.85)
        local hasM = false
        for _, m in ipairs(muts) do
            local mn = m.Name or m.Id or ""
            hasM = true
            if #CONFIG.SelectedMutations > 0 then
                local f = false
                for _, sm in ipairs(CONFIG.SelectedMutations) do
                    if sm == mn then f = true break end
                end
                if not f then hasM = false end
            end
            v = v * (m.Multiplier or m.EarningMulti or 1)
        end
        if #CONFIG.SelectedMutations > 0 and not hasM then v = 0 end
        if #CONFIG.SelectedEggs > 0 then
            local f = false
            for _, se in ipairs(CONFIG.SelectedEggs) do
                if se == en then f = true break end
            end
            if not f then v = 0 end
        end
        if #CONFIG.SelectedRarities > 0 then
            local f = false
            for _, sr in ipairs(CONFIG.SelectedRarities) do
                if sr == rar then f = true break end
            end
            if not f then v = 0 end
        end
        if #CONFIG.SelectedAreas > 0 then
            local f = false
            for _, sa in ipairs(CONFIG.SelectedAreas) do
                if sa == area then f = true break end
            end
            if not f then v = 0 end
        end
        if v > bestV then bestV = v bestE = en end
    end
    return bestV >= CONFIG.MinMoney, bestV, bestE
end

