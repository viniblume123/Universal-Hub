    local drag = false
    local function upd(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local raw = min + a * (max - min)
        local st = math.floor(raw / step + 0.5) * step
        val = math.clamp(st, min, max)
        local al = (val - min) / (max - min)
        fill.Size = UDim2.new(al, 0, 1, 0)
        kn.Position = UDim2.new(al, -8, 0.5, -8)
        vLbl.Text = tostring(val)
    end

    hit.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true
            upd(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch) then
            upd(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch) and drag then
            drag = false
            if o.Callback then o.Callback(val) end
        end
    end)

    return {
        Set = function(v)
            val = math.clamp(v, min, max)
            local al = (val - min) / (max - min)
            fill.Size = UDim2.new(al, 0, 1, 0)
            kn.Position = UDim2.new(al, -8, 0.5, -8)
            vLbl.Text = tostring(val)
        end,
        Get = function() return val end,
    }
end

local function addDropdown(parent, o)
    local values = o.Values or {}
    local multi = o.Multi or false
    local sel = o.Value or (multi and {} or nil)

    local c = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = C.Element, BorderSizePixel = 0, ZIndex = 4,
    }, parent)
    crn(c, 10)

    local lbl = mk("TextLabel", {
        Text = o.Title or "Dropdown", Font = Enum.Font.GothamMedium,
        TextSize = 13, TextColor3 = C.Sub, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(1, -70, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, c)

    local arw = mk("TextLabel", {
        Text = "▾", Font = Enum.Font.GothamBold, TextSize = 15,
        TextColor3 = C.Sub, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -36, 0.5, -10), ZIndex = 5,
    }, c)

    local countBadge = mk("Frame", {
        Size = UDim2.fromOffset(0, 20),
        Position = UDim2.new(1, -60, 0.5, -10),
        BackgroundColor3 = C.Accent, BorderSizePixel = 0,
        Visible = false, ZIndex = 5,
    }, c)
    crn(countBadge, 10)
    local badgeLbl = mk("TextLabel", {
        Text = "0",
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextColor3 = C.Text, BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1), ZIndex = 6,
    }, countBadge)

    local function refreshLbl()
        if multi then
            local n = 0
            for _ in pairs(sel) do n = n + 1 end
            if n == 0 then
                lbl.Text = o.Title or "Dropdown"
                lbl.TextColor3 = C.Sub
                countBadge.Visible = false
            else
                lbl.Text = o.Title or "Dropdown"
                lbl.TextColor3 = C.Text
                countBadge.Visible = true
                badgeLbl.Text = tostring(n)
                countBadge.Size = UDim2.fromOffset(math.max(20, #tostring(n) * 8 + 12), 20)
            end
        else
            if sel then
                lbl.Text = tostring(sel)
                lbl.TextColor3 = C.Accent
                countBadge.Visible = false
            else
                lbl.Text = o.Title or "Dropdown"
                lbl.TextColor3 = C.Sub
                countBadge.Visible = false
            end
        end
    end

    local function isSelected(v)
        if multi then return sel[v] == true end
        return sel == v
    end

    local function openList()
        closeDropdown()

        local bgClose = mk("TextButton", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 1,
        }, overlayGui)

        local lh = math.min(#values * 32 + 12, 240)
        local posX = c.AbsolutePosition.X
        local posY = c.AbsolutePosition.Y + c.AbsoluteSize.Y + 6

        if posY + lh > workspace.CurrentCamera.ViewportSize.Y then
            posY = c.AbsolutePosition.Y - lh - 6
        end

        local list = mk("Frame", {
            Size = UDim2.fromOffset(c.AbsoluteSize.X, lh),
            Position = UDim2.fromOffset(posX, posY),
            BackgroundColor3 = C.Panel,
            BorderSizePixel = 0,
            ZIndex = 2,
        }, overlayGui)
        crn(list, 12)
        strk(list, C.Border, 1)
        pad(list, 6)

        local scroll = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = C.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 3,
        }, list)
        mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

        local function refreshItems()
            for _, ch in ipairs(scroll:GetChildren()) do
                if ch:IsA("TextButton") then
                    local t = ch:FindFirstChildOfClass("TextLabel")
                    if t then
                        if isSelected(t.Text) then
                            t.TextColor3 = C.Accent
                        else
                            t.TextColor3 = C.Text
                        end
                    end
                end
            end
        end

        for _, v in ipairs(values) do
            local it = mk("TextButton", {
                Text = "", BackgroundColor3 = C.Element,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 30),
                AutoButtonColor = false, ZIndex = 4,
            }, scroll)
            crn(it, 7)

            local iLbl = mk("TextLabel", {
                Text = tostring(v), Font = Enum.Font.GothamMedium,
                TextSize = 12, TextColor3 = C.Text,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(1, -28, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
            }, it)

            it.MouseEnter:Connect(function()
                TweenService:Create(it, TweenInfo.new(0.1), { BackgroundColor3 = C.Hover }):Play()
            end)
            it.MouseLeave:Connect(function()
                TweenService:Create(it, TweenInfo.new(0.1), { BackgroundColor3 = C.Element }):Play()
            end)

            it.MouseButton1Click:Connect(function()
                if multi then
                    if sel[v] then sel[v] = nil else sel[v] = true end
                    refreshItems()
                    refreshLbl()
                    if o.Callback then
                        local a = {}
                        for k in pairs(sel) do table.insert(a, k) end
                        o.Callback(a)
                    end
                else
                    sel = v
                    refreshLbl()
                    closeDropdown()
                    if o.Callback then o.Callback(sel) end
                end
            end)
        end

        refreshItems()

        local function closeList()
            if bgClose then bgClose:Destroy() end
            if list then list:Destroy() end
        end

        bgClose.MouseButton1Click:Connect(closeList)
        closeActiveDropdown = closeList
    end

    refreshLbl()

    local btn = mk("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, Text = "", ZIndex = 6,
    }, c)
    btn.MouseButton1Click:Connect(function()
        if closeActiveDropdown then
            closeDropdown()
        else
            openList()
        end
    end)
    btn.MouseEnter:Connect(function()
        TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Hover }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Element }):Play()
    end)

    return { Set = function(v) sel = v refreshLbl() end, Get = function() return sel end }
end

