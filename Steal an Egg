local function makeBtn(text, pos, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 180, 0, 45)
    b.Position = pos
    b.BackgroundColor3 = color or Color3.fromRGB(30, 30, 30)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(220, 220, 220)
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Active = true
    b.Parent = Gui

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(80, 80, 80)
    s.Thickness = 1.5
    s.Parent = b

    return b
end

local function makeDraggable(btn, onClick)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local didDrag = false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            didDrag = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then
                didDrag = true
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not didDrag then
                onClick()
            end
            dragging = false
            didDrag = false
        end
    end)
end

-- ===== Botão: Server Hop =====
local hopBtn = makeBtn("Server Hop", UDim2.new(0.5, -90, 0.85, 0))

makeDraggable(hopBtn, function()
    if hopBtn:GetAttribute("Hop") then return end
    hopBtn:SetAttribute("Hop", true)
    hopBtn.Text = "Procurando..."

    if not pcall(HttpService.GetAsync, HttpService, "https://httpbin.org/get") then
        hopBtn.Text = "HTTP off"
        task.wait(2)
        hopBtn.Text = "Server Hop"
        hopBtn:SetAttribute("Hop", false)
        return
    end

    local servers = getServerList()
    if #servers == 0 then
        hopBtn.Text = "Sem servidor"
        task.wait(2)
        hopBtn.Text = "Server Hop"
        hopBtn:SetAttribute("Hop", false)
        return
    end

    local av = filterVisited(servers)
    if #av == 0 then av = servers end
    local chosen = av[math.random(1, #av)]
    markVisited(chosen.id)

    hopBtn.Text = "Entrando..."
    pcall(function()
        TeleportService:TeleportToPlaceInstance(PLACE_ID, chosen.id, LocalPlayer)
    end)
    hopBtn:SetAttribute("Hop", false)
end)

-- ===== Botão: Auto-Exec =====
local persistOn = false
local persistBtn = makeBtn("Auto-Exec: OFF", UDim2.new(0.5, -90, 0.75, 0))

local queueFunc = queue_on_teleport
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
    or queueonteleport

local function setQueue(code)
    if queueFunc then
        pcall(function() queueFunc(code) end)
        return true
    end
    return false
end

if queueFunc then
    LocalPlayer.OnTeleport:Connect(function()
        if persistOn and SCRIPT_URL ~= "" then
            queueFunc("loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()")
        end
    end)
end

makeDraggable(persistBtn, function()
    if not persistOn then
        if SCRIPT_URL == "" then
            persistBtn.Text = "Configure URL"
            task.wait(2)
            persistBtn.Text = "Auto-Exec: OFF"
            Notify("Auto-Exec", "Coloque a URL do script na variável SCRIPT_URL", 4)
            return
        end

        local code = "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
        if setQueue(code) then
            persistOn = true
            persistBtn.Text = "Auto-Exec: ON"
            persistBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
            Notify("Auto-Exec", "Ativado", 2)
        else
            persistBtn.Text = "Sem suporte"
            task.wait(2)
            persistBtn.Text = "Auto-Exec: OFF"
            Notify("Auto-Exec", "Seu executor não suporta queue_on_teleport", 4)
        end
    else
        setQueue("")
        persistOn = false
        persistBtn.Text = "Auto-Exec: OFF"
        persistBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        Notify("Auto-Exec", "Desativado", 2)
    end
end)

