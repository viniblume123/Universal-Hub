local function addSlider(parent, o)
    local min = o.Min or 0
    local max = o.Max or 100
    local def = o.Default or min
    local step = o.Step or 1
    local val = def
    local c = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.Element,
        BorderSizePixel = 0, ZIndex = 4,
    }, parent)
    crn(c, 10)
    mk("TextLabel", {
        Text = o.Title or "Slider", Font = Enum.Font.GothamMedium,
        TextSize = 12, TextColor3 = C.Sub, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 10), Size = UDim2.new(0.7, 0, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, c)
    local vLbl = mk("TextLabel", {
        Text = tostring(val), Font = Enum.Font.Code, TextSize = 17,
        TextColor3 = C.Number, BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 6), Size = UDim2.new(1, -16, 0, 22),
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
    }, c)
    local track = mk("Frame", {
        Size = UDim2.new(1, -32, 0, 6), Position = UDim2.new(0, 16, 0, 40),
        BackgroundColor3 = C.Bg, BorderSizePixel = 0, ZIndex = 5,
    }, c)
    crn(track, 3)
    local fill = mk("Frame", {
        Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 6,
    }, track)
    crn(fill, 3)
    local kn = mk("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new((val - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 7,
    }, track)
    crn(kn, 8)
    strk(kn, C.Accent, 2, 0)
    local hit = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 30),
        BackgroundTransparency = 1, Text = "", ZIndex = 8,
    }, c)
    local drag = false
    local function upd(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local raw = min + a * (max - min)
        local st = math.floor(raw / step + 0.5) * step
        val = math.clamp(st, min, max)
        local al = (val - min) / (max - min)
        fill.Size = UDim2.new(al, 0, 1, 0)
        kn.Position = UDim2.new(al, -8, 0.5, -8)
        vLbl.Text = tostring(val)
    end
    hit.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true upd(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch) then
            upd(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch) and drag then
            drag = false
            if o.Callback then o.Callback(val) end
            saveConfig()
        end
    end)
    return { Set = function(v) val = math.clamp(v, min, max) end, Get = function() return val end }
end

local function addDropdown(parent, o)
    local values = o.Values or {}
    local sel = o.Value or {}
    if type(sel) ~= "table" then sel = {} end
    local converted = {}
    for k, v in pairs(sel) do
        if type(k) == "number" then converted[v] = true else converted[k] = v end
    end
    sel = converted
    local c = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = C.Element,
        BorderSizePixel = 0, ZIndex = 4,
    }, parent)
    crn(c, 10)
    local lbl = mk("TextLabel", {
        Text = o.Title or "Dropdown", Font = Enum.Font.GothamMedium, TextSize = 13,
        TextColor3 = C.Sub, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -70, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, c)
    local arw = mk("TextLabel", {
        Text = "▾", Font = Enum.Font.GothamBold, TextSize = 15,
        TextColor3 = C.Sub, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -36, 0.5, -10), ZIndex = 5,
    }, c)
    local badge = mk("Frame", {
        Size = UDim2.fromOffset(24, 20), Position = UDim2.new(1, -64, 0.5, -10),
        BackgroundColor3 = C.Accent, BorderSizePixel = 0, Visible = false, ZIndex = 5,
    }, c)
    crn(badge, 10)
    local badgeLbl = mk("TextLabel", {
        Text = "0", Font = Enum.Font.Code, TextSize = 12,
        TextColor3 = C.Text, BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1), ZIndex = 6,
    }, badge)
    local function refreshLbl()
        local n = setSize(sel)
        if n == 0 then
            lbl.Text = o.Title or "Dropdown"
            lbl.TextColor3 = C.Sub
            badge.Visible = false
        else
            lbl.Text = o.Title or "Dropdown"
            lbl.TextColor3 = C.Text
            badge.Visible = true
            badgeLbl.Text = tostring(n)
            badge.Size = UDim2.fromOffset(math.max(24, #tostring(n) * 9 + 14), 20)
            badge.Position = UDim2.new(1, -22 - badge.Size.X.Offset, 0.5, -10)
        end
    end
    local function openList()
        if closeActiveDropdown then closeActiveDropdown() end
        local bgClose = mk("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "", ZIndex = 0,
        }, overlayGui)
        local lh = math.min(#values * 32 + 12, 240)
        local posX = c.AbsolutePosition.X
        local posY = c.AbsolutePosition.Y + c.AbsoluteSize.Y + 6
        if posY + lh > workspace.CurrentCamera.ViewportSize.Y then
            posY = c.AbsolutePosition.Y - lh - 6
        end
        local list = mk("Frame", {
            Size = UDim2.fromOffset(c.AbsoluteSize.X, lh),
            Position = UDim2.fromOffset(posX, posY),
            BackgroundColor3 = C.Panel, BorderSizePixel = 0, ZIndex = 2,
        }, overlayGui)
        crn(list, 12)
        strk(list, C.Border, 1)
        pad(list, 6)
        local scroll = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = C.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 3,
        }, list)
        mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
        for _, v in ipairs(values) do
            local it = mk("TextButton", {
                Text = "", BackgroundColor3 = sel[v] and C.Hover or C.Element,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 30),
                AutoButtonColor = false, ZIndex = 4,
            }, scroll)
            crn(it, 7)
            local iLbl = mk("TextLabel", {
                Text = tostring(v), Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = sel[v] and C.Accent or C.Text,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -28, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
            }, it)
            it.MouseEnter:Connect(function()
                TweenService:Create(it, TweenInfo.new(0.1), { BackgroundColor3 = C.Hover }):Play()
            end)
            it.MouseLeave:Connect(function()
                TweenService:Create(it, TweenInfo.new(0.1), {
                    BackgroundColor3 = sel[v] and C.Hover or C.Element,
                }):Play()
            end)
            it.MouseButton1Click:Connect(function()
                if sel[v] then
                    sel[v] = nil iLbl.TextColor3 = C.Text it.BackgroundColor3 = C.Element
                else
                    sel[v] = true iLbl.TextColor3 = C.Accent it.BackgroundColor3 = C.Hover
                end
                refreshLbl()
                if o.Callback then o.Callback(sel) end
                saveConfig()
            end)
        end
        local function closeList()
            if bgClose then bgClose:Destroy() end
            if list then list:Destroy() end
        end
        bgClose.MouseButton1Click:Connect(closeList)
        closeActiveDropdown = closeList
    end
    refreshLbl()
    local btn = mk("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = "", ZIndex = 6,
    }, c)
    btn.MouseButton1Click:Connect(function()
        if closeActiveDropdown then closeActiveDropdown() else openList() end
    end)
    btn.MouseEnter:Connect(function()
        TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Hover }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(c, TweenInfo.new(0.15), { BackgroundColor3 = C.Element }):Play()
    end)
    return { Set = function(v)
        sel = {}
        if type(v) == "table" then
            for k, vv in pairs(v) do
                if type(k) == "number" then sel[vv] = true else sel[k] = vv end
            end
        end
        refreshLbl()
    end, Get = function() return sel end }
end

