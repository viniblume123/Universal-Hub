local function HttpGet(Url)
    if REQUEST then
        local Ok, Res = pcall(REQUEST, {Url = Url, Method = "GET"})
        if Ok and type(Res) == "table" and Res.Body and Res.Body ~= "" then
            return Res.Body
        end
    end
    local Ok, Res = pcall(function() return game:HttpGet(Url) end)
    if Ok and Res and Res ~= "" then return Res end
    return nil
end

local function HttpGetRetry(Url, Tries)
    Tries = Tries or 3
    for I = 1, Tries do
        local Res = HttpGet(Url)
        if Res and Res ~= "" then return Res end
        if I < Tries then task.wait(0.3) end
    end
    return nil
end

local function ReadJson(Path, Default)
    if not isfile or not isfile(Path) then return Default end
    local Ok, Content = pcall(readfile, Path)
    if not Ok or not Content then return Default end
    local Ok2, Parsed = pcall(HttpService.JSONDecode, HttpService, Content)
    if Ok2 and type(Parsed) == "table" then return Parsed end
    return Default
end

local function WriteJson(Path, Data)
    if writefile then pcall(writefile, Path, HttpService:JSONEncode(Data)) end
end

local function ReadVisited()
    local Data = ReadJson(STORAGE_FILE, {})
    local Now = os.time()
    for K, V in pairs(Data) do
        if type(V) ~= "number" or (Now - V) >= COOLDOWN_TIME then Data[K] = nil end
    end
    return Data
end

local Visited = ReadVisited()
Visited[game.JobId] = os.time()
WriteJson(STORAGE_FILE, Visited)

local function IsBlocked(JobId)
    local T = Visited[JobId]
    if not T then return false end
    if (os.time() - T) >= COOLDOWN_TIME then
        Visited[JobId] = nil
        WriteJson(STORAGE_FILE, Visited)
        return false
    end
    return true
end

local function MarkVisited(JobId)
    if JobId and JobId ~= "" then
        Visited[JobId] = os.time()
        WriteJson(STORAGE_FILE, Visited)
    end
end

