local queueFunc = queue_on_teleport
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
    or queueonteleport

local function setQueue(code)
    if not queueFunc then return false end
    pcall(function() queueFunc(code) end)
    return true
end

local function enableAutoExec()
    if SCRIPT_URL == "" then return false end
    if not queueFunc then return false end
    local code = "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
    if not setQueue(code) then return false end
    if teleportConn then teleportConn:Disconnect() end
    teleportConn = LocalPlayer.OnTeleport:Connect(function()
        if persistOn then
            setQueue(code)
        end
    end)
    return true
end

local function disableAutoExec()
    if teleportConn then
        teleportConn:Disconnect()
        teleportConn = nil
    end
    setQueue("")
    persistOn = false
end

