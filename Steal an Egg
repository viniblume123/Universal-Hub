local function FindLennonRoot()
    for _, Container in ipairs(GetGuiContainers()) do
        local Ok, Descendants = pcall(function() return Container:GetDescendants() end)
        if Ok and Descendants then
            for _, Obj in ipairs(Descendants) do
                if Obj:IsA("TextLabel") and type(Obj.Text) == "string" then
                    if Obj.Text:upper():find("LENNON") then
                        local Root = Obj
                        while Root.Parent and Root.Parent ~= Container do
                            Root = Root.Parent
                        end
                        if Root and Root.Parent == Container then
                            return Root
                        end
                    end
                end
            end
        end
    end
    return nil
end

