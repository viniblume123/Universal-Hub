local function parseMoney(s)
    if type(s) == "number" then return s end
    if type(s) ~= "string" then return 0 end
    local clean = s:gsub("%s", ""):upper()
    local suf = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Q = 1e15 }
    local n = tonumber(clean)
    if n then return n end
    local sfx = clean:match("([KMBTQ])$")
    if sfx then
        local base = tonumber(clean:sub(1, -2))
        if base then return base * suf[sfx] end
    end
    return 0
end

local function bindRemote(cat, act)
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    local net = pk and pk:FindFirstChild("Networking")
    if net then
        local c = net:FindFirstChild(cat)
        if c then return c:FindFirstChild(act .. "RF") or c:FindFirstChild(act) end
    end
    local nw = ReplicatedStorage:FindFirstChild("Network")
    if nw then
        local c = nw:FindFirstChild(cat)
        if c then return c:FindFirstChild(act) end
    end
end

local function getSnap()
    local r = bindRemote("EggWorld", "AskFieldEggSnapshot")
    if not r then return {} end
    local ok, s = pcall(function() return r:InvokeServer() end)
    if ok and type(s) == "table" then return s end
    return {}
end

local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(PlaceId)
    local ok, b = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    return ok and b and b.data or {}
end

local function findServer()
    local servers = getServers()
    local pool = {}
    for _, s in ipairs(servers) do
        if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
            local n = s.playing or 0
            if n >= CONFIG.MinPlayers and n <= CONFIG.MaxPlayers then
                table.insert(pool, s)
            end
        end
    end
    if #pool == 0 then
        for _, s in ipairs(servers) do
            if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
                return s.id
            end
        end
        return nil
    end
    table.sort(pool, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
    return pool[1].id
end

local function checkEggs()
    local snap = getSnap()
    if #snap == 0 then return false, 0, nil end
    local bestV, bestE = 0, nil
    for _, egg in ipairs(snap) do
        local en = egg.Name or egg.EggName or ""
        local rar = egg.Rarity or egg.Category or ""
        local area = egg.Area or ""
        local muts = egg.Mutations or {}
        local rate = egg.EarningRate or egg.Rate or 0
        local scale = egg.Scale or 1
        local v = rate * (scale ^ 1.85)
        local hasM = false
        for _, m in ipairs(muts) do
            local mn = m.Name or m.Id or ""
            hasM = true
            if #CONFIG.SelectedMutations > 0 then
                local f = false
                for _, sm in ipairs(CONFIG.SelectedMutations) do
                    if sm == mn then f = true break end
                end
                if not f then hasM = false end
            end
            v = v * (m.Multiplier or m.EarningMulti or 1)
        end
        if #CONFIG.SelectedMutations > 0 and not hasM then v = 0 end
        if #CONFIG.SelectedEggs > 0 then
            local f = false
            for _, se in ipairs(CONFIG.SelectedEggs) do
                if se == en then f = true break end
            end
            if not f then v = 0 end
        end
        if #CONFIG.SelectedRarities > 0 then
            local f = false
            for _, sr in ipairs(CONFIG.SelectedRarities) do
                if sr == rar then f = true break end
            end
            if not f then v = 0 end
        end
        if #CONFIG.SelectedAreas > 0 then
            local f = false
            for _, sa in ipairs(CONFIG.SelectedAreas) do
                if sa == area then f = true break end
            end
            if not f then v = 0 end
        end
        if v > bestV then bestV = v bestE = en end
    end
    return bestV >= CONFIG.MinMoney, bestV, bestE
end

local function doHop()
    local t = findServer()
    if t then
        TeleportService:TeleportToPlaceInstance(PlaceId, t, LocalPlayer)
    else
        TeleportService:Teleport(PlaceId, LocalPlayer)
    end
end

local function queueAutoExec()
    if AUTO_EXEC_URL == "" then return end
    local ok, src = pcall(game.HttpGet, game, AUTO_EXEC_URL)
    if not ok or not src then return end
    local f = queue_on_teleport or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport) or (krnl and krnl.queue_on_teleport)
