local function ArmLoader()
    if not queueFunc then return false end
    return pcall(function() queueFunc(BuildLoader()) end)
end

local function EnableAutoExec()
    if not queueFunc then return false end
    if game.PlaceId ~= ALLOWED_PLACE_ID then
        Notify("Auto-Exec", "Only Works in This Game", 4)
        return false
    end
    WriteAutoExec(true)
    if not ArmLoader() then
        WriteAutoExec(false)
        return false
    end
    PersistOn = true
    return true
end

local function DisableAutoExec()
    PersistOn = false
    WriteAutoExec(false)
    ArmLoader()
end

PersistBtn.MouseButton1Click:Connect(function()
    if not PersistOn then
        if EnableAutoExec() then
            ApplyAutoExecVisual(true)
            Notify("Auto-Exec", "Enabled for This Game", 3)
        else
            PersistBtn.Text = "Not Supported"
            task.wait(2)
            PersistBtn.Text = "Auto-Exec  Off"
        end
    else
        DisableAutoExec()
        ApplyAutoExecVisual(false)
        Notify("Auto-Exec", "Disabled", 3)
    end
end)

local function ApplyVersion(Goal)
    local F = VFeatures[Goal]
    if not F then return end

    if F.lennon and not State.hasLennon then
        TryLoad(LENNON_URL, "Lennon Hub")
        State.hasLennon = true
    end
    if F.on and not State.hasOn then
        TryLoad(ONHUB_URL, "ON Hub")
        State.hasOn = true
    end
    if F.auto and not State.hasAuto then
        StartLennonAutoClick()
        State.hasAuto = true
    end

    local Achieved = GetDisplayVersion()
    if Achieved then WriteSavedVersion(Achieved) end
    pcall(RefreshStats)
end

