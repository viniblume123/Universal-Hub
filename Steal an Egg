local function TryClickLennonToggle()
    local Root = FindLennonRoot()
    if not Root then return false end

    local Ok, Desc = pcall(function() return Root:GetDescendants() end)
    if not Ok or not Desc then return false end

    for _, Obj in ipairs(Desc) do
        if Obj:IsA("TextButton") or Obj:IsA("ImageButton") then
            local Corner = Obj:FindFirstChildOfClass("UICorner")
            if Corner then
                local Cr = Corner.CornerRadius
                if Cr.X.Scale >= 0.5 and Cr.Y.Scale >= 0.5 then
                    if FireClick(Obj) then return true end
                end
            end
        end
    end

    for _, Obj in ipairs(Desc) do
        if Obj:IsA("Frame") then
            local Corner = Obj:FindFirstChildOfClass("UICorner")
            if Corner then
                local Cr = Corner.CornerRadius
                if Cr.X.Scale >= 0.5 and Cr.Y.Scale >= 0.5 then
                    local Size = Obj.AbsoluteSize
                    if Size.X >= 15 and Size.X <= 45 and Size.Y >= 15 and Size.Y <= 45 then
                        local Parent = Obj.Parent
                        while Parent and Parent ~= Root do
                            if Parent:IsA("TextButton") or Parent:IsA("ImageButton") then
                                if FireClick(Parent) then return true end
                                break
                            end
                            Parent = Parent.Parent
                        end
                    end
                end
            end
        end
    end

    return false
end

