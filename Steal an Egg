local function FindToggleCandidates()
    local Cands = {}
    local Seen = {}

    local function Add(Obj, Priority)
        if Seen[Obj] then return end
        Seen[Obj] = true
        table.insert(Cands, {obj = Obj, priority = Priority})
    end

    for _, Container in ipairs(GetGuiContainers()) do
        local Ok, Desc = pcall(function() return Container:GetDescendants() end)
        if Ok and Desc then
            for _, Obj in ipairs(Desc) do
                if Obj:IsA("TextLabel") and type(Obj.Text) == "string" and #Obj.Text > 0 then
                    local Up = Obj.Text:upper()
                    local Matched = false
                    for _, Kw in ipairs(Keywords) do
                        if Up:find(Kw) then Matched = true; break end
                    end
                    if Matched then
                        local P = Obj.Parent
                        if P then
                            for _, Sib in ipairs(P:GetChildren()) do
                                if (Sib:IsA("TextButton") or Sib:IsA("ImageButton")) and IsRoundish(Sib) then
                                    Add(Sib, 1)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if #Cands == 0 then
        for _, Container in ipairs(GetGuiContainers()) do
            local Ok, Desc = pcall(function() return Container:GetDescendants() end)
            if Ok and Desc then
                for _, Obj in ipairs(Desc) do
                    if Obj:IsA("TextButton") or Obj:IsA("ImageButton") then
                        local Sz = Obj.AbsoluteSize
                        if Sz.X <= 60 and Sz.Y <= 60 and IsRoundish(Obj) then
                            Add(Obj, 2)
                        end
                    end
                end
            end
        end
    end

    table.sort(Cands, function(A, B) return A.priority < B.priority end)
    return Cands
end

local function TryClickLennonToggle()
    local Cands = FindToggleCandidates()
    if #Cands == 0 then return false end
    for _, Entry in ipairs(Cands) do
        if FireClick(Entry.obj) then return true end
    end
    return false
end

