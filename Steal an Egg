local function MakeBtn(Text, YPos, Variant)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -24, 0, 36)
    Btn.Position = UDim2.new(0, 12, 0, YPos)
    Btn.BackgroundColor3 = COL.Card
    Btn.Text = Text
    Btn.TextColor3 = COL.Text
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.BorderSizePixel = 0
    Btn.AutoButtonColor = false
    Btn.Parent = Panel

    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0, 10)
    C.Parent = Btn

    local S = Instance.new("UIStroke")
    S.Color = COL.Stroke
    S.Thickness = 1
    S.Transparency = 0.3
    S.Parent = Btn

    local BaseBg = COL.Card
    local BaseStroke = COL.Stroke
    local BaseText = COL.Text

    if Variant == "success" then
        BaseBg = COL.SuccessBg
        BaseStroke = COL.Success
        BaseText = COL.Text
    elseif Variant == "accent" then
        BaseBg = COL.PurpleBg
        BaseStroke = COL.Accent
        BaseText = COL.Text
    end

    Btn.BackgroundColor3 = BaseBg
    S.Color = BaseStroke
    Btn.TextColor3 = BaseText

    local function Restore()
        local Bg = BaseBg
        local St = BaseStroke
        local Tx = BaseText
        if Btn:GetAttribute("Toggle") and PersistOn then
            Bg = COL.SuccessBg
            St = COL.Success
        end
        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Bg}):Play()
        TweenService:Create(S, TweenInfo.new(0.15), {Color = St, Transparency = 0.3}):Play()
        Btn.TextColor3 = Tx
    end

    Btn.MouseEnter:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.15), {
            BackgroundColor3 = BaseBg:Lerp(Color3.fromRGB(255,255,255), 0.08)
        }):Play()
        TweenService:Create(S, TweenInfo.new(0.15), {Color = COL.StrokeHot, Transparency = 0}):Play()
    end)
    Btn.MouseLeave:Connect(Restore)

    return Btn, S
end

