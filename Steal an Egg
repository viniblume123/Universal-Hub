local snapshotRemote = nil
local remoteFound = false

local function findSnapshotRemote()
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteFunction") then
            local n = d.Name:lower()
            if n:find("askfieldeggsnapshot") or n:find("fieldreggsnapshot")
               or n:find("fieldeggsnapshot") or n:find("eggsnapshot")
               or (n:find("snapshot") and n:find("egg")) then
                return d
            end
        end
    end
    return nil
end

local function getSnap()
    if not snapshotRemote then
        snapshotRemote = findSnapshotRemote()
        if snapshotRemote then
            remoteFound = true
        end
    end
    if not snapshotRemote then return {} end
    local ok, s = pcall(function() return snapshotRemote:InvokeServer() end)
    if ok and type(s) == "table" then
        local arr = {}
        if #s > 0 then
            arr = s
        else
            for _, v in pairs(s) do
                if type(v) == "table" then table.insert(arr, v) end
            end
        end
        return arr
    end
    return {}
end

local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(PlaceId)
    local ok, b = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    return ok and b and b.data or {}
end

local function findServer()
    local servers = getServers()
    local pool = {}
    for _, s in ipairs(servers) do
        if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
            local n = s.playing or 0
            if n <= CONFIG.MaxPlayers then
                table.insert(pool, s)
            end
        end
    end
    if #pool == 0 then
        for _, s in ipairs(servers) do
            if s.id ~= JobId and (s.playing or 0) < (s.maxPlayers or 50) then
                return s.id
            end
        end
        return nil
    end
    table.sort(pool, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
    return pool[1].id
end

local function setSize(set)
    if type(set) ~= "table" then return 0 end
    local n = 0
    for _ in pairs(set) do n = n + 1 end
    return n
end

local function checkEggs()
    local snap = getSnap()
    if #snap == 0 then return false, 0, nil, false end

    local minMoney = parseMoney(CONFIG.MinMoneyText)
    local bestV, bestE = 0, nil
    local anySpawned = false

    local hasEggFilter = setSize(CONFIG.SelectedEggs) > 0

    for _, egg in ipairs(snap) do
        if type(egg) ~= "table" then continue end

        local en = egg.Name or egg.EggName or egg.PetName or ""
        local muts = egg.Mutations or {}
        if type(muts) ~= "table" then muts = {} end

        if hasEggFilter then
            local found = false
            for name in pairs(CONFIG.SelectedEggs) do
                if en == name then
                    found = true
                    break
                end
            end
            if not found then continue end
        end

        anySpawned = true
        local rate = egg.EarningRate or egg.Rate or 0
        local scale = egg.Scale or 1
        local v = rate * (scale ^ 1.85)
        for _, m in ipairs(muts) do
            if type(m) == "table" then
                v = v * (m.Multiplier or m.EarningMulti or 1)
            end
        end
        if v > bestV then
            bestV = v
            bestE = en
        end
    end

    return bestV >= minMoney, bestV, bestE, anySpawned
end

local function doHop()
    local t = findServer()
    if t then
        TeleportService:TeleportToPlaceInstance(PlaceId, t, LocalPlayer)
    else
        TeleportService:Teleport(PlaceId, LocalPlayer)
    end
end

