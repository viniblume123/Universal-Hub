local function IsRoundish(Obj)
    local Corner = Obj:FindFirstChildOfClass("UICorner")
    if not Corner then return false end
    local Cr = Corner.CornerRadius
    if Cr.X.Scale >= 0.4 then return true end
    if Cr.Offset >= 10 and Obj.AbsoluteSize.X <= 60 and Obj.AbsoluteSize.Y <= 60 then
        return true
    end
    return false
end

