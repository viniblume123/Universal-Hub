end

local function bindRemote(cat, act)
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    local net = pk and pk:FindFirstChild("Networking")
    if net then
        local c = net:FindFirstChild(cat)
        if c then return c:FindFirstChild(act .. "RF") or c:FindFirstChild(act) end
    end
    local nw = ReplicatedStorage:FindFirstChild("Network")
    if nw then
        local c = nw:FindFirstChild(cat)
        if c then return c:FindFirstChild(act) end
    end
end

local function getSnap()
