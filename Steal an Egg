local function makeBtn(text, yPos, isToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(225, 225, 240)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = panel

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 9)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(70, 70, 95)
    s.Thickness = 1
    s.Transparency = 0.4
    s.Parent = btn

    btn.MouseEnter:Connect(function()
        if isToggle and persistOn then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(44, 44, 62)}):Play()
        TweenService:Create(s, TweenInfo.new(0.15), {Color = Color3.fromRGB(120, 130, 230), Transparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if isToggle and persistOn then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(28, 78, 50)}):Play()
            TweenService:Create(s, TweenInfo.new(0.15), {Color = Color3.fromRGB(80, 220, 140), Transparency = 0.3}):Play()
            return
        end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 42)}):Play()
        TweenService:Create(s, TweenInfo.new(0.15), {Color = Color3.fromRGB(70, 70, 95), Transparency = 0.4}):Play()
    end)

    return btn, s
end

