local function waitTeleportCooldown()
    local last = readLastTeleport()
    local elapsed = os.time() - last
    if elapsed < TELEPORT_COOLDOWN then
        local remaining = TELEPORT_COOLDOWN - elapsed
        for i = remaining, 1, -1 do
            if GENV.SAE_INSTANCE_ID ~= INSTANCE_ID then return end
            hopBtn.Text = "Aguardando " .. i .. "s..."
            task.wait(1)
        end
    end
end

local hopBusy = false

hopBtn.MouseButton1Click:Connect(function()
    if hopBusy then return end
    hopBusy = true
    task.spawn(function()
        hopBtn.Text = "Procurando..."

        while hopBusy and GENV.SAE_INSTANCE_ID == INSTANCE_ID do
            waitTeleportCooldown()
            if GENV.SAE_INSTANCE_ID ~= INSTANCE_ID then break end

            local server = findBestServer()
            if not server then
                task.wait(0.5)
                server = findBestServer()
            end

            if GENV.SAE_INSTANCE_ID ~= INSTANCE_ID then break end

            if server then
                markVisited(server.id)
                hopBtn.Text = "Entrando..."

                local ok = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, LocalPlayer)
                end)

                if not ok then
                    hopBtn.Text = "Falhou, retry..."
                    task.wait(HOP_RETRY_DELAY)
                else
                    writeLastTeleport(os.time())
                    task.wait(HOP_RETRY_DELAY)
                end
            else
                hopBtn.Text = "Sem srv, retry..."
                task.wait(HOP_RETRY_DELAY)
            end
        end

        if GENV.SAE_INSTANCE_ID == INSTANCE_ID then
            hopBtn.Text = "Server Hop"
        end
    end)
end)

