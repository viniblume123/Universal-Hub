local REQUEST = (syn and syn.request) or (http and http.request) or http_request or request

local function httpGet(url)
    if REQUEST then
        local ok, res = pcall(REQUEST, {Url = url, Method = "GET"})
        if ok and type(res) == "table" and res.Body and res.Body ~= "" then
            return res.Body
        end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res and res ~= "" then return res end
    return nil
end

local function readVisited()
    local data = {}
    if isfile and isfile(STORAGE_FILE) then
        local ok, content = pcall(readfile, STORAGE_FILE)
        if ok and content then
            local ok2, parsed = pcall(HttpService.JSONDecode, HttpService, content)
            if ok2 and type(parsed) == "table" then data = parsed end
        end
    end
    local now = os.time()
    for k, v in pairs(data) do
        if type(v) ~= "number" or (now - v) >= COOLDOWN_TIME then
            data[k] = nil
        end
    end
    return data
end

local function writeVisited(data)
    if writefile then
        pcall(writefile, STORAGE_FILE, HttpService:JSONEncode(data))
    end
end

local visited = readVisited()
visited[game.JobId] = os.time()
writeVisited(visited)

local function isBlocked(jobId)
    local t = visited[jobId]
    if not t then return false end
    if (os.time() - t) >= COOLDOWN_TIME then
        visited[jobId] = nil
        writeVisited(visited)
        return false
    end
    return true
end

local function markVisited(jobId)
    if jobId and jobId ~= "" then
        visited[jobId] = os.time()
        writeVisited(visited)
    end
end

local function getFriendGameIds()
    local ids = {}
    if not REQUEST then return ids end
    local res = httpGet("https://friends.roblox.com/v1/users/" .. LocalPlayer.UserId .. "/friends")
    if not res then return ids end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok or not data or not data.data then return ids end
    local list = {}
    for _, f in ipairs(data.data) do table.insert(list, f.id) end
    if #list == 0 then return ids end
    for i = 1, #list, 100 do
        local batch = {}
        for j = i, math.min(i + 99, #list) do table.insert(batch, list[j]) end
        local body = HttpService:JSONEncode({userIds = batch})
        local ok2, res2 = pcall(REQUEST, {
            Url = "https://presence.roblox.com/v1/presence/users",
            Method = "POST",
            Body = body,
            Headers = {["Content-Type"] = "application/json"}
        })
        if ok2 and res2 and res2.Body then
            local ok3, pres = pcall(HttpService.JSONDecode, HttpService, res2.Body)
            if ok3 and pres and pres.userPresences then
                for _, p in ipairs(pres.userPresences) do
                    if p.gameId and p.gameId ~= "" then ids[p.gameId] = true end
                end
            end
        end
    end
    return ids
end

local function fetchPage(cursor)
    local url = "https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end
    local res = httpGet(url)
    if not res then return nil end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok or type(data) ~= "table" then return nil end
    return data
end

local function collectCandidates(filterFn, friendIds)
    local candidates = {}
    local cursor = nil
    local pages = 0
    while pages < MAX_PAGES do
        pages = pages + 1
        local data = fetchPage(cursor)
        if not data or not data.data then break end
        for _, sv in ipairs(data.data) do
            if sv.id and sv.id ~= game.JobId and sv.playing < sv.maxPlayers then
                if filterFn(sv, friendIds) then
                    table.insert(candidates, sv)
                end
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
    end
    return candidates
end

local function pickBest(candidates)
    table.sort(candidates, function(a, b)
        if a.playing ~= b.playing then return a.playing < b.playing end
        return (a.ping or 999) < (b.ping or 999)
    end)
    local poolSize = math.min(5, #candidates)
    return candidates[math.random(1, poolSize)]
end

local function findBestServer()
    local friendIds = getFriendGameIds()
    local strict = collectCandidates(function(sv, f)
        return not isBlocked(sv.id) and not f[sv.id]
    end, friendIds)
    if #strict > 0 then return pickBest(strict) end

    local ignoreVisited = collectCandidates(function(sv, f)
        return not f[sv.id]
    end, friendIds)
    if #ignoreVisited > 0 then return pickBest(ignoreVisited) end

    local anyPublic = collectCandidates(function() return true end, friendIds)
    if #anyPublic > 0 then return pickBest(anyPublic) end

    return nil
end

