-- === Friend cache / server finding (inalterado) ===
local friendCache = {ids = nil, time = 0}

local function getFriendGameIds()
    if friendCache.ids and (os.time() - friendCache.time) < FRIEND_CACHE_TIME then
        return friendCache.ids
    end
    local ids = {}
    if REQUEST then
        local res = httpGetRetry("https://friends.roblox.com/v1/users/" .. LocalPlayer.UserId .. "/friends", 2)
        if res then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, res)
            if ok and data and data.data then
                local list = {}
                for _, f in ipairs(data.data) do table.insert(list, f.id) end
                for i = 1, #list, 100 do
                    local batch = {}
                    for j = i, math.min(i + 99, #list) do table.insert(batch, list[j]) end
                    local body = HttpService:JSONEncode({userIds = batch})
                    local ok2, res2 = pcall(REQUEST, {
                        Url = "https://presence.roblox.com/v1/presence/users",
                        Method = "POST",
                        Body = body,
                        Headers = {["Content-Type"] = "application/json"}
                    })
                    if ok2 and res2 and res2.Body then
                        local ok3, pres = pcall(HttpService.JSONDecode, HttpService, res2.Body)
                        if ok3 and pres and pres.userPresences then
                            for _, p in ipairs(pres.userPresences) do
                                if p.gameId and p.gameId ~= "" then ids[p.gameId] = true end
                            end
                        end
                    end
                end
            end
        end
    end
    friendCache.ids = ids
    friendCache.time = os.time()
    return ids
end

local function fetchPage(cursor, sortOrder)
    sortOrder = sortOrder or "Asc"
    local url = "https://games.roblox.com/v1/games/" .. PLACE_ID ..
                "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end
    local res = httpGetRetry(url, 3)
    if not res then return nil end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok or type(data) ~= "table" then return nil end
    return data
end

local function collectCandidates(filterFn, friendIds, sortOrder)
    local candidates = {}
    local cursor = nil
    local pages = 0
    while pages < MAX_PAGES do
        pages = pages + 1
        local data = fetchPage(cursor, sortOrder)
        if not data or not data.data then break end
        for _, sv in ipairs(data.data) do
            if sv.id and sv.id ~= game.JobId and sv.playing < sv.maxPlayers then
                if filterFn(sv, friendIds) then
                    table.insert(candidates, sv)
                end
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
        if #candidates >= 25 then break end
    end
    return candidates
end

local function pickBest(candidates)
    table.sort(candidates, function(a, b)
        if a.playing ~= b.playing then return a.playing < b.playing end
        return (a.ping or 999) < (b.ping or 999)
    end)
    local poolSize = math.min(5, #candidates)
    return candidates[math.random(1, poolSize)]
end

local function findBestServer()
    local friendIds = getFriendGameIds()
    local orders = {"Asc", "Desc"}

    for _, order in ipairs(orders) do
        local c = collectCandidates(function(sv, f)
            return not isBlocked(sv.id) and not f[sv.id]
        end, friendIds, order)
        if #c > 0 then return pickBest(c) end
    end

    for _, order in ipairs(orders) do
        local c = collectCandidates(function(sv, f)
            return not f[sv.id]
        end, friendIds, order)
        if #c > 0 then return pickBest(c) end
    end

    for _, order in ipairs(orders) do
        local c = collectCandidates(function() return true end, friendIds, order)
        if #c > 0 then return pickBest(c) end
    end

    return nil
end

