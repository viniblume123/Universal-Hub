-- Find game objects with extreme precision
local function safeFindFirstChild(parent, name)
    local success, result = pcall(function()
        return parent:FindFirstChild(name, true)
    end)
    return success and result or nil
end

local function waitForObject(path, timeout)
    timeout = timeout or 1.2
    local start = tick()
    local current = Workspace
    
    for _, name in ipairs(path) do
        while tick() - start < timeout do
            local child = safeFindFirstChild(current, name)
            if child then
                current = child
                break
            end
            task.wait(0.02)
        end
    end
    
    return current ~= Workspace and current or nil
end

